{
  "name": "dmep",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node backend/dist/server.js",
    "test": "node scripts/test.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:seed": "node scripts/db.mjs seed",
    "db:bootstrap": "node scripts/db.mjs bootstrap",
    "check": "npm run check -w frontend && npm run build -w backend",
    "start:local": "node scripts/local-mongo.mjs",
    "dev:frontend": "npm run dev -w frontend"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.0",
    "supertest": "^7.1.0",
    "mongodb-memory-server": "^10.4.3"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
