# Copy to .env. Never commit secrets. Node.js 24 is required.
NODE_ENV=development
PORT=4100
APP_URL=http://127.0.0.1:4100
ORGANISATION_NAME=Sydney Beacon
# Required for an external MongoDB. Must support transactions (Atlas or replica set).
# start:local starts a persistent loopback-only development replica set instead.
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DATABASE=dmep
ALLOW_SANDBOX_PAYMENTS=false
LOG_LEVEL=info
TRUST_PROXY=0
# Synthetic seed only. Set your own 12+ character password.
DEMO_PASSWORD=
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Beacon <receipts@example.org>
